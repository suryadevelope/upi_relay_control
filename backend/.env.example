# ==========================================
# Smart Gateway - Backend Environment Config
# ==========================================

# Server Port
PORT=3000

# Razorpay API Credentials
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere

# Razorpay Webhook Secret (Set in Dashboard -> Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Shared Device Authentication Key (Must match ESP32 deviceKey)
DEVICE_API_KEY=sg_device_secret_key_123

# Mock / Sandbox Mode (true/false)
# Set to 'true' to simulate payments and UPI QR without active Razorpay account
# Set to 'false' to connect directly to live/test Razorpay API
MOCK_MODE=true

# Your real UPI ID, used for the QR in MOCK_MODE (e.g. yourname@okaxis).
# A fake/unregistered ID makes UPI apps show "beneficiary UPI ID incorrect".
MERCHANT_VPA=
MERCHANT_NAME=Smart Gateway

# QR / payment session validity in seconds (minimum 120)
QR_EXPIRY_SEC=300
